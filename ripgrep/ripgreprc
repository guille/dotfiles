# Line numbers
-n

# Search case-insensitively if pattern is all lowercase.
--smart-case

# Follow symbolic links.
--follow

# Search hidden files and directories.
--hidden

# Exclude directories.
--glob=!{.git,node_modules,Trash}

# Don't print lines longer than this limit.
# --max-columns=500

# Colours
--colors=path:fg:0xfd,0x97,0x1f
--colors=line:fg:3
