#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

source "$SCRIPT_BASE_DIR/common"

##
# nvim
##

module_name=nvim


mkdir -p ~/.config/nvim/lua

infoprint "[$module_name] creating dotfiles symlinks..."

ln -sfv "${SCRIPT_BASE_DIR}/$module_name/init.lua" ~/.config/nvim/init.lua 1> /dev/null

for f in "${SCRIPT_BASE_DIR}/$module_name/"*.lua; do
	[[ "$(basename "$f")" == init.lua ]] && continue
	ln -sfv "$f" ~/.config/nvim/lua/ 1> /dev/null
done
