#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

source "$SCRIPT_BASE_DIR/common"

##
# mpv
##

module_name=mpv


# Linux only
if [[ "${DOTFILES_OS:-}" == "OSX" ]]; then
	exit
fi

mkdir -p ~/.config/mpv

infoprint "[$module_name] creating dotfiles symlinks..."

ln -sf "${SCRIPT_BASE_DIR}/$module_name/mpv.conf" ~/.config/mpv/mpv.conf
ln -sf "${SCRIPT_BASE_DIR}/$module_name/input.conf" ~/.config/mpv/input.conf
