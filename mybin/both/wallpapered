#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'open3'

WALLPAPERS_DIR = File.join(Dir.home, "Wallpapers")
VERTICAL_WALLPAPERS_GLOB = File.join(WALLPAPERS_DIR, "Vertical", "*")
DUAL_WALLPAPERS_GLOB = File.join(WALLPAPERS_DIR, "Dual", "*")
SINGLE_WALLPAPERS_GLOB = File.join(WALLPAPERS_DIR, "Single", "*")

# mirrorOf?
# transform = rotations
  # 0 is normal
  # 0, 2, 4, 6 are horizontal, rest are vertical
  # 4-7 are flipped
MonitorInfo = Data.define(:name, :x, :y, :transform, :physicalWidth, :physicalHeight) do
  def vertical?
    transform.odd?
  end

  # Assume a monitor with diagonal smaller than 420mm is a laptop screen
  def laptop?
    Math.sqrt(physicalHeight**2 + physicalWidth**2) <= 420
  end

  # Compare by x-axis, smaller = to the left
  def <=>(other)
    x <=> other.x
  end
end
Job = Data.define(:image, :monitor)

def fetch_monitors_data
  stdout, stderr, status = Open3.capture3('hyprctl', 'monitors', '-j')
  raise "hyprctl failed (exit #{status.exitstatus}): #{stderr}" unless status.success?

  JSON.parse(stdout, symbolize_names: true).map do
    MonitorInfo.new(**it.slice(*MonitorInfo.members))
  end
end

def dual_jobs(left, right)
  image = Dir[DUAL_WALLPAPERS_GLOB].sample or return

  case File.basename(image, '.*')
  when /_left\z/
    [Job.new(monitor: left.name, image:), Job.new(monitor: right.name, image: image.sub('_left', '_right'))]
  when /_right\z/
    [Job.new(monitor: right.name, image:), Job.new(monitor: left.name, image: image.sub('_right', '_left'))]
  else
    warn "Don't know what to do with #{image}, falling back to single wallpapers"
    nil
  end
end

# Sampled together to avoid dups
def single_jobs(monitors, glob)
  monitors.zip(Dir[glob].sample(monitors.size)).filter_map do |monitor, image|
    Job.new(monitor: monitor.name, image:) if image
  end
end

def process_data(data)
  verticals, horizontals = data.partition(&:vertical?)

  # Exactly two monitors, neither of them is vertical, and it's not a laptop's internal: find Dual wallpapers
  if horizontals.size == 2 && verticals.empty? && horizontals.none?(&:laptop?)
    jobs = dual_jobs(*horizontals.minmax)
    return jobs if jobs
  end

  single_jobs(verticals, VERTICAL_WALLPAPERS_GLOB) + single_jobs(horizontals, SINGLE_WALLPAPERS_GLOB)
end

def reap_workers!(pids, sig: "TERM")
  pids.each { |pid| Process.kill(sig, pid) rescue Errno::ESRCH }
end

def spawn_workers(jobs)
  jobs.map do |job|
    spawn('swaybg', '-o', job.monitor, '-m', 'fill', '-i', job.image).tap do |pid|
      puts "Spawned worker PID #{pid} for monitor #{job.monitor} (img: #{job.image})"
    end
  end
end

def wall!
  spawn_workers(process_data(fetch_monitors_data))
end

def log_exit(pid, status)
  if status.signaled?
    puts "PID #{pid} killed by signal #{status.termsig}"
  else
    puts "PID #{pid} exited with status #{status.exitstatus}"
  end
end

$stdout.sync = true

$pids = []
$stop = false
$reload = false

# Propagate SIGTERM and SIGINT to all children
%w[TERM INT].each do |sig|
  Signal.trap(sig) do
    puts "\nReceived SIG#{sig}, forwarding to children..."
    $stop = true
    reap_workers!($pids, sig:)
  end
end

Signal.trap("HUP") do
  $reload = true
  reap_workers!($pids)
end

until $stop
  $reload = false
  begin
    $pids = wall!
  rescue => e
    warn "Failed to set wallpapers: #{e.message}"
    $pids = []
  end

  if $pids.empty?
    sleep 5
    next
  end

  # A HUP that landed while spawning may have been based on stale monitor data
  reap_workers!($pids) if $reload

  # Whatever ends first (HUP, output gone, crash), redraw everything
  log_exit(*Process.wait2)
  reap_workers!($pids)
  Process.waitall.each { log_exit(*it) }

  # Debounces hotplug bursts and keeps a failing swaybg from spinning
  sleep 1 unless $stop
end
