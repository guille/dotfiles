#!/usr/bin/env zsh
# Navigable cal(1). Needs util-linux cal.

# Months are counted as year*12 + month-1, so navigation is plain arithmetic.
read y m <<< "$(date '+%Y %m')"
today=$(( y * 12 + m - 1 )) focus=$today n=3
nl=$'\n' el=$'\e[K'
help=$'\e[2m←/→ month  ↑/↓ or k/j 3 months  H/L year  t today  1/3/6 months  y year  q quit\e[0m'

# cal only highlights today when it's the month it was asked for, so render
# each month separately and lay them out three per row.
render() {
  local -a months lines
  local i r l c line start=$(( focus - n / 2 ))
  for (( i = start; i < start + n; i++ )); do
    months+=("$(cal --color=always $(( i % 12 + 1 )) $(( i / 12 )))")
  done
  frame=
  for (( r = 1; r <= n; r += 3 )); do
    (( r > 1 )) && frame+=$nl
    for (( l = 1; l <= 8; l++ )); do
      line=
      for (( c = r; c < r + 3 && c <= n; c++ )); do
        lines=("${(@f)months[c]}")
        line+="${lines[l]}  "
      done
      frame+=$line$nl
    done
  done
  frame+=$nl$help
}

print -n '\e[?1049h\e[?25l'
trap 'print -n "\e[?25h\e[?1049l"' EXIT
trap 'exit 130' INT

while true; do
  render
  # Erase leftovers per line instead of clearing the screen, so nothing flashes.
  print -rn -- $'\e[H'"${frame//$nl/$el$nl}"$el$'\e[J'
  read -sk1 k
  if [[ $k == $'\e' ]]; then
    read -sk2 -t 0.01 rest
    case $rest in
      '[D') k=left ;; '[C') k=right ;; '[A') k=k ;; '[B') k=j ;;
    esac
  fi
  case $k in
    left) (( focus -= 1 )) ;;
    right) (( focus += 1 )) ;;
    k) (( focus -= 3 )) ;;
    j) (( focus += 3 )) ;;
    H) (( focus -= 12 )) ;;
    L) (( focus += 12 )) ;;
    t) focus=$today ;;
    1|3|6) n=$k ;;
    y) n=12 focus=$(( focus / 12 * 12 + 6 )) ;;
    q) break ;;
  esac
done
