class ConfirmDelete(ModalScreen[bool | None]):
    BINDINGS = [
        Binding("escape,n,q", "dismiss(None)", "Cancel"),
        Binding("y", "confirm", "Delete"),
    ]

    def __init__(
        self,
        mem: Memory,
        backlinks: list[tuple[Memory, int, str]],
        dangling: list[Memory],
    ) -> None:
        super().__init__()
        self.mem, self.refs, self.dangling = mem, backlinks, dangling

    def compose(self) -> ComposeResult:
        mem = self.mem
        facts = Table.grid(padding=(0, 2))
        facts.add_column(style="dim", no_wrap=True)
        facts.add_column(overflow="fold")
        facts.add_row(
            "File",
            Text(tildify(str(mem.path)))
            if mem.path
            else Text("already missing, only the pointer goes", "italic"),
        )
        if mem.pointer:
            facts.add_row(f"MEMORY.md:{mem.pointer_line}", Text(mem.pointer.strip()))
        else:
            facts.add_row("MEMORY.md", Text("not indexed, nothing to remove", "italic"))
        refs = Table.grid(padding=(0, 2))
        labels = [f"{other.filename}:{n}" for other, n, _ in self.refs[:8]]
        refs.add_column(
            style="dim",
            no_wrap=True,
            min_width=min(40, max(map(len, labels), default=0)),
        )
        refs.add_column(no_wrap=True, overflow="ellipsis")
        for label, (_, _, line) in zip(labels, self.refs):
            refs.add_row(Text(label), Text(line))
        if len(self.refs) > 8:
            refs.add_row(f"… {len(self.refs) - 8} more", "")
        with Vertical(id="dialog"):
            yield Static(
                Text.assemble(
                    ("Delete ", "bold"), (mem.title, f"bold {ERROR}"), ("?", "bold")
                ),
                id="dialog-title",
            )
            yield Static(facts)
            if self.refs:
                n = len(self.refs)
                yield Static(
                    Text(
                        f"⚠ {n} link{'s' * (n > 1)} to it will dangle:", f"bold {WARN}"
                    )
                )
                yield Static(refs, classes="indent")
            if self.dangling:
                names = ", ".join(m.filename for m in self.dangling[:3]) + (
                    " …" if len(self.dangling) > 3 else ""
                )
                yield Static(
                    Text(
                        f"MEMORY.md already has {len(self.dangling)} dangling pointer(s): {names}",
                        WARN,
                    )
                )
                yield Checkbox("Clean those up too", value=True, id="cleanup")
            with Horizontal(id="buttons"):
                yield Button("Cancel  n", id="cancel")
                yield Button("Delete  y", variant="error", id="delete")

    def on_mount(self) -> None:
        self.query_one("#delete").focus()

    def action_confirm(self) -> None:
        boxes = self.query(Checkbox)
        self.dismiss(bool(boxes) and boxes.first().value)

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.action_confirm() if event.button.id == "delete" else self.dismiss(None)


