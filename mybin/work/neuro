def linkify_wiki(body: str) -> str:
    """[[slug]] → markdown links the preview can follow, leaving code untouched."""
    parts = CODE_RE.split(body)
    for i in range(0, len(parts), 2):
        parts[i] = WIKI_RE.sub(
            lambda m: f"[{m.group(1)}](neuro:{m.group(1).strip()})", parts[i]
        )
    return "".join(parts)


