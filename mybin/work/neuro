def editor_command(path: Path, line: int | None) -> tuple[list[str], bool]:
    cmd = shlex.split(
        os.environ.get("NEURO_EDITOR")
        or os.environ.get("VISUAL")
        or os.environ.get("EDITOR")
        or "vi"
    )
    exe = Path(cmd[0]).name
    if line and exe in PLUS_LINE_EDITORS:
        cmd += [f"+{line}", str(path)]
    elif line and exe in {"subl", "sublime_text", "zed", "zeditor", "cursor"}:
        cmd.append(f"{path}:{line}")
    elif line and exe in {"code", "codium"}:
        cmd += ["-g", f"{path}:{line}"]
    else:
        cmd.append(str(path))
    return cmd, exe in GUI_EDITORS


