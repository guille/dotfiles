        yield Footer()

    def on_mount(self) -> None:
        state = self.load_state()
        self.theme = (
            state.get("theme")
            if state.get("theme") in self.available_themes
            else "tokyo-night"
        )
        self.sort = state.get("sort") if state.get("sort") in SORTS else "index"
        self.watch(self, "theme", lambda _: self.save_state(), init=False)
        self.watch(self.screen, "focused", self.focus_changed, init=False)
        self.query_one("#projects-pane").border_title = "Projects"
        self.query_one("#preview-pane").border_title = "Preview"
        self.projects = load_all()
        self._sig = signature()
        here = os.getcwd()
        best = max(
            (
                p
                for p in self.projects
                if here == p.path or here.startswith(p.path + "/")
            ),
            key=lambda p: len(p.path),
            default=None,
        )
        if best:
            self.project_key = best.key
        self.fill_projects()
        self.fill_memories()
        self.query_one("#memories" if best else "#projects").focus()
        self.set_interval(1.5, self.poll)
        self.update_layout(self.size.width)

    def on_resize(self, event: events.Resize) -> None:
        self.update_layout(event.size.width)

    def update_layout(self, width: int) -> None:
        self.screen.set_class(width < 110, "-narrow")

    def load_state(self) -> dict[str, str]:
        try:
            return json.loads(STATE.read_text())
        except (OSError, ValueError):
            return {}

    def save_state(self) -> None:
        try:
            STATE.parent.mkdir(parents=True, exist_ok=True)
            STATE.write_text(json.dumps({"theme": self.theme, "sort": self.sort}))
        except OSError:
            pass

    # data → widgets

    @property
    def project(self) -> Project | None:
        return next((p for p in self.projects if p.key == self.project_key), None)

    def scoped_memories(self) -> list[Memory]:
        project = self.project
        mems = (
            list(project.memories)
            if project
            else [m for p in self.projects for m in p.memories]
        )
        if q := self.filters["memories"]:
            mems = [m for m in mems if matches(m.haystack, q)]
        match self.sort:
            case "recent":
                mems.sort(key=lambda m: -m.mtime)
            case "type":
                order = list(TYPES)
                mems.sort(
                    key=lambda m: order.index(m.type) if m.type in order else len(order)
                )
            case "name":
                mems.sort(key=lambda m: m.title.lower())
        return mems

    def fill_projects(self) -> None:
        nav = self.query_one("#projects", Nav)
        q = self.filters["projects"]
        shown = [p for p in self.projects if matches(f"{p.path} {p.key}".lower(), q)]
        total = sum(len(p.files) for p in self.projects)
        all_row = Table.grid(expand=True, padding=(0, 1))
        all_row.add_column(ratio=1, no_wrap=True)
        all_row.add_column(justify="right", no_wrap=True)
        all_row.add_row(Text("★ All memories", "bold"), Text(str(total), "dim"))
        all_row.add_row(Text(f"{len(self.projects)} projects", "dim"), "")
        options = [Option(all_row, id=ALL)] + [
            Option(self.project_prompt(p, q), id=p.key) for p in shown
        ]
        self.restore(nav, options, self.project_key)
        pane = self.query_one("#projects-pane")
        pane.border_subtitle = f"/{q}" if q else ""
        self.update_topbar()

    def project_prompt(self, p: Project, q: str) -> Table:
        grid = Table.grid(expand=True, padding=(0, 1))
        grid.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
        grid.add_column(justify="right", no_wrap=True)
        name = Text(p.name, "bold" if p.exists else "dim strike")
        count = Text(str(len(p.files)), "dim")
        if issues := len(p.issues):
            count = Text.assemble((f"⚠{issues} ", WARN), count)
        sub = Text(p.parent, "dim")
        for t in (name, sub):
            t.highlight_words(q.split(), "reverse", case_sensitive=False) if q else None
        grid.add_row(name, count)
        grid.add_row(sub, Text(ago(p.mtime), "dim"))
        return grid

    def fill_memories(self, keep: str | None = None) -> None:
        nav = self.query_one("#memories", Nav)
        mems = self.scoped_memories()
        q = self.filters["memories"]
        options = [Option(self.memory_prompt(m, q), id=m.id) for m in mems]
        current = keep or (
            nav.highlighted_option.id if nav.highlighted_option else None
        )
        self.restore(nav, options, current)
        project = self.project
        pane = self.query_one("#memories-pane")
        pane.border_title = (
            f"{project.name if project else 'All memories'} · {len(mems)}"
        )
        bits = [f"/{q}"] if q else []
        if self.sort != "index":
            bits.append(f"sort: {self.sort}")
        pane.border_subtitle = "  ".join(bits)
        if not options:
            self.schedule_preview()

    def memory_prompt(self, m: Memory, q: str) -> Table:
        glyph, color = badge(m.type)
        grid = Table.grid(expand=True, padding=(0, 1))
        grid.add_column(width=1, no_wrap=True)
        grid.add_column(ratio=1, no_wrap=True, overflow="ellipsis")
        grid.add_column(justify="right", no_wrap=True)
        if m.missing:
            title = Text(m.title, f"strike {ERROR}")
            flag = Text("missing", ERROR)
            glyph, color = "✗", ERROR
        else:
            title = Text(m.title, "bold")
            flag = Text.assemble(
                ("unindexed ", WARN) if m.orphan else "", (ago(m.mtime), "dim")
            )
        sub = Text(no_wrap=True, overflow="ellipsis", style="dim")
        if self.project is None:
            sub.append(f"{m.project.name} · ", "italic")
        sub.append(m.description or m.filename)
        if q:
            for t in (title, sub):
                t.highlight_words(q.split(), "reverse", case_sensitive=False)
        grid.add_row(Text(glyph, color), title, flag)
        grid.add_row("", sub, "")
        return grid

    def restore(self, nav: Nav, options: list[Option], keep: str | None) -> None:
        old = nav.highlighted
        nav.set_options(options)
        if not options:
            return
        ids = [o.id for o in options]
        nav.highlighted = (
            ids.index(keep) if keep in ids else min(old or 0, len(ids) - 1)
        )

    def update_topbar(self) -> None:
        total = sum(len(p.files) for p in self.projects)
        issues = sum(len(p.issues) for p in self.projects)
        bar = Text.assemble(
            ("neuro", "bold"),
            "  ",
            (f"{total} memories in {len(self.projects)} projects", "dim"),
        )
        if issues:
            bar.append(f"   ⚠ {issues} index issue{'s' * (issues > 1)}", WARN)
        if self.undo_stack:
            bar.append(f"   ↶ {len(self.undo_stack)} undoable", "dim")
        self.query_one("#topbar", Static).update(bar)

    # selection & preview

    def highlighted_memory(self) -> Memory | None:
        nav = self.query_one("#memories", Nav)
        opt = nav.highlighted_option
        if opt is None:
            return None
        key, _, filename = opt.id.partition("/")
        project = next((p for p in self.projects if p.key == key), None)
        return (
            next((m for m in project.memories if m.filename == filename), None)
            if project
            else None
        )

    def subject(self) -> Memory | Project | None:
        return self.highlighted_memory() if self.context == "memories" else self.project

    def on_option_list_option_highlighted(
        self, event: OptionList.OptionHighlighted
    ) -> None:
        if event.option_list.id == "projects" and event.option.id != self.project_key:
            self.project_key = event.option.id
            self.fill_memories()
        self.schedule_preview()

    def on_option_list_option_selected(self, event: OptionList.OptionSelected) -> None:
        self.action_pane(1)

    def focus_changed(self, widget) -> None:
        wid = widget.id if widget else None
        if wid in ("projects", "memories"):
            self.context = wid
        self.screen.set_class(wid == "preview", "-detail")
        self.schedule_preview()

    def schedule_preview(self) -> None:
        if self._preview_timer:
            self._preview_timer.stop()
        self._preview_timer = self.set_timer(0.04, self.render_preview)

    def render_preview(self, force: bool = False) -> None:
        subject = self.subject()
        key = (id(subject), getattr(subject, "mtime", 0), self.context)
        if key == self._shown and not force:
            return
        self._shown = key
        self.refresh_bindings()
        self.link_targets = []
        meta, body, links = (
            self.query_one("#meta", Static),
            self.query_one("#body", Markdown),
            self.query_one("#links", Static),
        )
        pane = self.query_one("#preview-pane")
        if isinstance(subject, Memory):
            pane.border_title = subject.filename
            meta.update(self.memory_header(subject))
            body.update(
                linkify_wiki(subject.body)
                if subject.path
                else self.missing_body(subject)
            )
            links.update(self.memory_links(subject))
        elif isinstance(subject, Project):
            pane.border_title = "MEMORY.md"
            meta.update(self.project_header(subject))
            body.update(subject.index_text or "*No MEMORY.md*")
            links.update(self.project_issues(subject))
        else:
            pane.border_title = "Preview"
            meta.update(self.overview())
            body.update("")
            links.update("")
        self.query_one("#preview", Preview).scroll_home(animate=False)

    def memory_header(self, m: Memory) -> Content:
        glyph, color = badge(m.type)
        parts = ["[b]$title[/]\n", f"[{color}]{glyph} $type[/]"]
        if m.path:
            when = ago(m.mtime)
            parts.append(
                f"  [dim]· {'just now' if when == 'now' else when + ' ago'} · $slug[/]"
            )
        if m.description:
            parts.append("\n[i]$desc[/]")
        extra = {
            k: v
            for k, v in m.meta.items()
            if k not in ("name", "description", "type", "metadata")
        }
        if isinstance(nested := m.meta.get("metadata"), dict):
            extra |= {k: v for k, v in nested.items() if k != "type"}
        extras = " · ".join(f"{k} {v}" for k, v in extra.items())
        if extras:
            parts.append("\n[dim]$extras[/]")
        if m.orphan:
            parts.append(
                f"\n\n[{WARN}]⚠ Not listed in MEMORY.md, so Claude won't see it. Press [b]a[/b] to add a pointer.[/]"
            )
        parts.append("\n[dim]" + "─" * 40 + "[/]")
        return Content.from_markup(
            "".join(parts),
            title=m.title,
            type=m.type or "untyped",
            slug=m.slug,
            desc=m.description,
            extras=extras,
        )

    def missing_body(self, m: Memory) -> str:
        return (
            f"> **MEMORY.md points at `{m.filename}`, but that file doesn't exist.**\n>\n"
            f"> Line {m.pointer_line}: `{(m.pointer or '').strip()}`\n\n"
            "Press **d** to drop the pointer, or **i** to fix it in MEMORY.md."
        )

    def link(self, mem: Memory, label: str | None = None) -> str:
        self.link_targets.append(mem)
        _, color = badge(mem.type)
        return f"[{color}]•[/] [@click=app.open_ref({len(self.link_targets) - 1})]{self.esc(label or mem.title)}[/]"

    @staticmethod
    def esc(text: str) -> str:
        return text.replace("[", r"\[")

    def memory_links(self, m: Memory) -> Content:
        if not m.path:
            return Content("")
        out = []
        outgoing = m.project.links(m)
        if outgoing:
            out.append("[dim]Links to[/]")
            for ref, target in outgoing:
                out.append(
                    "  " + self.link(target)
                    if target
                    else f"  [{ERROR}]✗ {self.esc(ref)} (missing)[/]"
                )
        back = {other.id: other for other, _, _ in m.project.backlinks(m)}
        if back:
            out.append("[dim]Linked from[/]")
            out.extend("  " + self.link(other) for other in back.values())
        return Content.from_markup("\n".join(out)) if out else Content("")

    def project_header(self, p: Project) -> Content:
        counts: dict[str, int] = {}
        for m in p.files:
            counts[m.type] = counts.get(m.type, 0) + 1
        chips = "   ".join(
            f"[{badge(t)[1]}]{badge(t)[0]} {n} {self.esc(t or 'untyped')}[/]"
            for t, n in sorted(counts.items(), key=lambda kv: -kv[1])
        )
        gone = "" if p.exists else f"  [{ERROR}](directory no longer exists)[/]"
        return Content.from_markup(
            f"[b]$name[/]  [dim]$path[/]{gone}\n{chips}\n[dim]" + "─" * 40 + "[/]",
            name=p.name,
            path=tildify(p.path),
        )

    def project_issues(self, p: Project) -> Content:
        if not p.issues:
            return Content("")
        out = [f"[{WARN}]Index issues[/]"]
        for m in p.issues:
            label = "missing file" if m.missing else "not in MEMORY.md"
            out.append(f"  {self.link(m, m.filename)}  [dim]{label}[/]")
        return Content.from_markup("\n".join(out))

    def overview(self) -> Content:
        return Content.from_markup("[dim]No memories match.[/]")

    def action_open_ref(self, i: int) -> None:
        if 0 <= i < len(self.link_targets):
            self.jump_to(self.link_targets[i])

    def on_markdown_link_clicked(self, event: Markdown.LinkClicked) -> None:
        href = event.href
        subject = self.subject()
        project = subject.project if isinstance(subject, Memory) else subject
        if "://" in href and not href.startswith("neuro:"):
            self.open_url(href)
            return
        if project and (
            target := project.resolve(norm_target(href.removeprefix("neuro:")))
        ):
            self.jump_to(target)
        else:
            self.notify(
                f"No memory called {href.removeprefix('neuro:')}", severity="warning"
            )

    def jump_to(self, mem: Memory) -> None:
        if self.project_key != ALL and self.project_key != mem.project.key:
            self.project_key = mem.project.key
            projects = self.query_one("#projects", Nav)
            try:
                projects.highlighted = projects.get_option_index(mem.project.key)
            except OptionDoesNotExist:
                self.filters["projects"] = ""
                self.fill_projects()
        if mem.id not in {m.id for m in self.scoped_memories()}:
            self.filters["memories"] = ""
        self.context = "memories"
        self.fill_memories(keep=mem.id)
        self.schedule_preview()

    # actions

    def check_action(self, action: str, parameters: tuple[object, ...]) -> bool | None:
        if not self.is_mounted:
            return True
        if self.screen is not self.screen_stack[0]:
            return action in ("quit", "command_palette")
        subject = self.subject()
        if action in ("delete", "copy_path"):
            return isinstance(subject, Memory) or None
        if action == "add_pointer":
            return isinstance(subject, Memory) and subject.orphan
        if action == "undo":
            return bool(self.undo_stack)
        if action in ("edit", "edit_index"):
            return subject is not None or None
        return True

    def action_pane(self, step: int) -> None:
        order = ["projects", "memories", "preview"]
        focused = self.focused.id if self.focused else "projects"
        if focused not in order:
            return
        if self.screen.has_class("-zoom"):
            if step < 0:
                self.screen.remove_class("-zoom")
                self.query_one("#memories").focus()
            return
        i = max(0, min(len(order) - 1, order.index(focused) + step))
        self.query_one(f"#{order[i]}").focus()

    def action_back(self) -> None:
        focused = self.focused.id if self.focused else None
        if focused is not None and self.filters.get(focused):
            self.filters[focused] = ""
            self.fill_projects() if focused == "projects" else self.fill_memories()
        else:
            self.action_pane(-1)

    def action_filter(self) -> None:
        self.filter_target = (
            "projects"
            if self.context == "projects"
            and self.focused
            and self.focused.id == "projects"
            else "memories"
        )
        box = self.query_one("#filter", FilterInput)
        box.placeholder = f"filter {self.filter_target}…   ↓ list · esc clear"
        box.value = self.filters[self.filter_target]
        box.add_class("-active")
        box.focus()

    def on_input_changed(self, event: Input.Changed) -> None:
        self.filters[self.filter_target] = event.value
        self.fill_projects() if self.filter_target == "projects" else self.fill_memories()

    def on_input_submitted(self, event: Input.Submitted) -> None:
        self.action_accept_filter()

    def action_accept_filter(self) -> None:
        self.query_one("#filter").remove_class("-active")
        self.query_one(f"#{self.filter_target}").focus()

    def action_cancel_filter(self) -> None:
        self.query_one("#filter", FilterInput).value = ""
        self.action_accept_filter()

    def action_cycle_sort(self) -> None:
        self.sort = SORTS[(SORTS.index(self.sort) + 1) % len(SORTS)]
        self.save_state()
        self.fill_memories()
        self.notify(f"Sorted by {self.sort}", timeout=1.5)

    def action_zoom(self) -> None:
        zoomed = self.screen.toggle_class("-zoom").has_class("-zoom")
        if zoomed:
            self.query_one("#preview").focus()

    def action_toggle_help(self) -> None:
        if self.screen.query("HelpPanel"):
            self.action_hide_help_panel()
        else:
            self.action_show_help_panel()

    def action_edit(self) -> None:
        subject = self.subject()
        if isinstance(subject, Memory) and subject.path:
            self.open_editor(subject.path)
        elif isinstance(subject, Memory):
            self.open_editor(subject.project.index_path, subject.pointer_line)
        elif isinstance(subject, Project):
            self.open_editor(subject.index_path)

    def action_edit_index(self) -> None:
        subject = self.subject()
        if isinstance(subject, Memory):
            self.open_editor(subject.project.index_path, subject.pointer_line)
        elif isinstance(subject, Project):
            self.open_editor(subject.index_path)

    def open_editor(self, path: Path, line: int | None = None) -> None:
        cmd, gui = editor_command(path, line)
        try:
            if gui:
                proc = subprocess.Popen(
                    cmd,
                    stdin=subprocess.DEVNULL,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                threading.Thread(target=proc.wait, daemon=True).start()
                self.notify(f"Opened {path.name} in {Path(cmd[0]).name}", timeout=2)
            else:
                with self.suspend():
                    subprocess.run(cmd, check=False)
                self.action_reload()
        except FileNotFoundError:
            self.notify(
                f"Editor not found: {cmd[0]} (set $NEURO_EDITOR or $EDITOR)",
                severity="error",
            )

    def action_copy_path(self) -> None:
        subject = self.subject()
        if isinstance(subject, Memory):
            path = str(subject.path or subject.project.index_path)
            self.copy_to_clipboard(path)
            self.notify(f"Copied {tildify(path)}", timeout=2)

    def action_add_pointer(self) -> None:
        subject = self.subject()
        if isinstance(subject, Memory) and subject.orphan:
            add_pointer(subject)
            self.action_reload()
            self.notify(f"Added {subject.filename} to MEMORY.md", timeout=2)

    def action_delete(self) -> None:
        mem = self.subject()
        if not isinstance(mem, Memory):
            return
        refs = mem.project.backlinks(mem) if mem.path else []
        dangling = [m for m in mem.project.memories if m.missing and m is not mem]

        def done(cleanup: bool | None) -> None:
            if cleanup is None:
                return
            try:
                record = delete(mem, dangling if cleanup else [])
            except OSError as e:
                self.notify(f"Delete failed: {e}", severity="error")
                return
            self.undo_stack.append(record)
            self.action_reload()
            what = "Deleted" if record.files else "Removed pointer to"
            self.notify(f"{what} “{mem.title}”  ·  u to undo", timeout=4)

        self.push_screen(ConfirmDelete(mem, refs, dangling), done)

    def action_undo(self) -> None:
        if not self.undo_stack:
            return
        record = self.undo_stack[-1]
        try:
            restore(record)
        except OSError as e:
            self.notify(f"Undo failed: {e}", severity="error")
            return
        self.undo_stack.pop()
        self.action_reload()
        self.notify(f"Restored “{record.title}”", timeout=2)

    def action_reload(self) -> None:
        self.projects = load_all()
        self._sig = signature()
        self._shown = None
        self.fill_projects()
        self.fill_memories()
        self.schedule_preview()
        self.refresh_bindings()

    def poll(self) -> None:
        if signature() != self._sig:
            self.action_reload()


if __name__ == "__main__":
    if not ROOT.is_dir():
        sys.exit(f"neuro: no Claude projects at {ROOT}")
    Neuro().run()
