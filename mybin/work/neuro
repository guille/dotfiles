POINTER_RE = re.compile(
    r"^\s*[-*+]\s+\[(?P<title>[^\]]*)\]\((?P<target>[^)\s]+)\)\s*(?:[—–:-]+\s*)?(?P<hook>.*?)\s*$"
)
WIKI_RE = re.compile(r"\[\[([^\]|#\n]+)(?:[|#][^\]\n]*)?\]\]")
MDLINK_RE = re.compile(r"\]\(([^)\s#]+\.md)(?:#[^)]*)?\)")
CWD_RE = re.compile(rb'"cwd":"((?:[^"\\]|\\.)*)"')
CODE_RE = re.compile(r"(```.*?```|`[^`\n]*`)", re.DOTALL)


# ── model ────────────────────────────────────────────────────────────────────


def norm_target(target: str) -> str:
    return posixpath.normpath(unquote(target)).removeprefix("./")


def humanize(slug: str) -> str:
    words = re.sub(r"[-_]+", " ", slug).strip()
    return words[:1].upper() + words[1:]


def unquote_yaml(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
        return value[1:-1]
    return value


def parse_frontmatter(text: str) -> tuple[Meta, str]:
    """Just enough YAML for memory frontmatter: scalars plus one level of nesting."""
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return {}, text
    end = next(
        (i for i in range(1, len(lines)) if lines[i].strip() in ("---", "...")), None
    )
    if end is None:
        return {}, text
    meta: Meta = {}
    parent: dict[str, str] | None = None
    for line in lines[1:end]:
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        key, sep, value = line.strip().partition(":")
        if not sep:
            continue
        key, value = key.strip(), unquote_yaml(value.strip())
        if line[0] in " \t" and parent is not None:
            parent[key] = value
        elif value == "":
            parent = meta[key] = {}
        else:
            parent = None
            meta[key] = value
    return meta, "\n".join(lines[end + 1 :]).lstrip("\n")


def outgoing_refs(text: str) -> list[str]:
    return [m.strip() for m in WIKI_RE.findall(text)] + [
        norm_target(m) for m in MDLINK_RE.findall(text)
    ]


def encode_path(path: str) -> str:
    return re.sub(r"[^A-Za-z0-9]", "-", path)


def project_path(project_dir: Path) -> str:
    """The real cwd, from session transcripts; the dir name alone is lossy (/ . _ all become -)."""
    for session in sorted(
        project_dir.glob("*.jsonl"), key=lambda p: -p.stat().st_mtime
    )[:5]:
        try:
            with session.open("rb") as f:
                chunk = f.read(256 * 1024)
        except OSError:
            continue
        for m in CWD_RE.finditer(chunk):
            cwd = json.loads(b'"' + m.group(1) + b'"')
            if encode_path(cwd) == project_dir.name:
                return cwd
    return guess_path(project_dir.name)


def guess_path(name: str) -> str:
    """Rebuild the path by walking the filesystem, preferring the longest existing segment."""
    tokens = name.split("-")[1:]

    def walk(base: str, rest: list[str]) -> str | None:
        if not rest:
            return base
        dot = rest[0] == "" and len(rest) > 1
        rest = rest[1:] if dot else rest
        for k in range(len(rest), 0, -1):
            for sep in "-_.":
                seg = ("." if dot else "") + sep.join(rest[:k])
                if os.path.isdir(cand := posixpath.join(base, seg)) and (
                    found := walk(cand, rest[k:])
                ):
                    return found
                if k == 1:
                    break
        return None

    return walk("/", tokens) or "/" + "/".join(tokens)


def tildify(path: str) -> str:
    return (
        "~" + path[len(HOME) :] if path == HOME or path.startswith(HOME + "/") else path
    )


def atomic_write(path: Path, text: str) -> None:
    tmp = path.with_name(f".{path.name}.neuro-tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


@dataclass(eq=False)
class Memory:
    project: Project
    filename: str
    path: Path | None
    title: str
    description: str = ""
    type: str = ""
    slug: str = ""
    meta: Meta = field(default_factory=dict)
    raw: str = ""
    body: str = ""
    mtime: float = 0.0
    pointer: str | None = None
    pointer_line: int | None = None
    _haystack: str | None = None

    @property
    def id(self) -> str:
        return f"{self.project.key}/{self.filename}"

    @property
    def missing(self) -> bool:
        return self.path is None

    @property
    def orphan(self) -> bool:
        return self.path is not None and self.pointer is None

    @property
    def haystack(self) -> str:
        if self._haystack is None:
            parts = (
                self.title,
                self.slug,
                self.filename,
                self.description,
                self.type,
                self.project.name,
                self.body,
            )
            self._haystack = "\n".join(parts).lower()
        return self._haystack


@dataclass(eq=False)
class Project:
    key: str
    memdir: Path
    path: str
    memories: list[Memory] = field(default_factory=list)
    index_text: str = ""
    mtime: float = 0.0
    _lookup: dict[str, Memory] = field(default_factory=dict)

    @property
    def index_path(self) -> Path:
        return self.memdir / "MEMORY.md"

    @property
    def name(self) -> str:
        return posixpath.basename(self.path.rstrip("/")) or self.path

    @property
    def parent(self) -> str:
        return tildify(posixpath.dirname(self.path.rstrip("/")))

    @property
    def exists(self) -> bool:
        return os.path.isdir(self.path)

    @property
    def files(self) -> list[Memory]:
        return [m for m in self.memories if not m.missing]

    @property
    def issues(self) -> list[Memory]:
        return [m for m in self.memories if m.missing or m.orphan]

    def resolve(self, ref: str) -> Memory | None:
        return self._lookup.get(ref) or self._lookup.get(ref.removesuffix(".md"))

    def links(self, mem: Memory) -> list[tuple[str, Memory | None]]:
        seen: dict[str, Memory | None] = {}
        for ref in outgoing_refs(mem.body):
            target = self.resolve(ref)
            if target is not mem:
                seen.setdefault(target.id if target else ref, target)
        return [(ref, target) for ref, target in seen.items()]

    def backlinks(self, mem: Memory) -> list[tuple[Memory, int, str]]:
        """Lines in other memories that link to `mem`, as (memory, 1-based line, text)."""
        hits = []
        for other in self.files:
            if other is mem:
                continue
            for n, line in enumerate(other.raw.splitlines(), 1):
                if any(self.resolve(r) is mem for r in outgoing_refs(line)):
                    hits.append((other, n, line.strip()))
        return hits


def read_text(path: Path) -> str:
    try:
        return path.read_text(errors="replace")
    except OSError:
        return ""


def load_memory(
    project: Project,
    path: Path,
    title: str | None,
    hook: str,
    line: str | None,
    n: int | None,
) -> Memory:
    raw = read_text(path)
    meta, body = parse_frontmatter(raw)
    nested = meta.get("metadata")
    if not isinstance(nested, dict):
        nested = {}
    slug = meta.get("name") or path.stem
    return Memory(
        project=project,
        filename=path.name,
        path=path,
        title=title or humanize(str(slug)),
        description=str(meta.get("description") or hook),
        type=str(meta.get("type") or nested.get("type") or ""),
        slug=str(slug),
        meta=meta,
        raw=raw,
        body=body,
        mtime=path.stat().st_mtime,
        pointer=line,
        pointer_line=n,
    )


def load_project(project_dir: Path, path: str) -> Project:
    memdir = project_dir / "memory"
    project = Project(key=project_dir.name, memdir=memdir, path=path)
    project.index_text = read_text(project.index_path)
    files = {
        e.name
        for e in os.scandir(memdir)
        if e.name.endswith(".md") and e.name != "MEMORY.md" and e.is_file()
    }
    seen: set[str] = set()
    for n, line in enumerate(project.index_text.splitlines(), 1):
        m = POINTER_RE.match(line)
        if not m or "://" in m["target"] or not m["target"].endswith(".md"):
            continue
        target = norm_target(m["target"])
        if target in seen:
            continue
        seen.add(target)
        if target in files or (memdir / target).is_file():
            project.memories.append(
                load_memory(project, memdir / target, m["title"], m["hook"], line, n)
            )
        else:
            project.memories.append(
                Memory(
                    project,
                    target,
                    None,
                    m["title"] or target,
                    m["hook"],
                    pointer=line,
                    pointer_line=n,
                )
            )
    for name in sorted(files - seen):
        project.memories.append(
            load_memory(project, memdir / name, None, "", None, None)
        )
    for mem in project.files:
        for key in (mem.slug, mem.filename, Path(mem.filename).stem):
            project._lookup.setdefault(key, mem)
    mtimes = [m.mtime for m in project.files]
    if project.index_path.exists():
        mtimes.append(project.index_path.stat().st_mtime)
    project.mtime = max(mtimes, default=0.0)
    return project


_paths: dict[str, str] = {}


def load_all() -> list[Project]:
    projects = []
    for entry in os.scandir(ROOT):
        memdir = Path(entry.path) / "memory"
        if not memdir.is_dir():
            continue
        if entry.name not in _paths:
            _paths[entry.name] = project_path(Path(entry.path))
        project = load_project(Path(entry.path), _paths[entry.name])
        if project.memories:
            projects.append(project)
    projects.sort(key=lambda p: -p.mtime)
    return projects


def signature() -> int:
    sig = []
    for entry in os.scandir(ROOT):
        try:
            for f in os.scandir(entry.path + "/memory"):
                st = f.stat()
                sig.append((f.path, st.st_mtime_ns, st.st_size))
        except (FileNotFoundError, NotADirectoryError):
            pass
    return hash(tuple(sig))


@dataclass
class Deletion:
    title: str
    index_path: Path
    files: list[tuple[Path, bytes]]
    lines: list[tuple[int, str]]


def remove_pointers(index_path: Path, targets: set[str]) -> list[tuple[int, str]]:
    """Drop index lines pointing at `targets`; returns the removed (0-based line, text) for undo."""
    if not targets or not index_path.exists():
        return []
    kept, removed = [], []
    for i, line in enumerate(index_path.read_text().splitlines(keepends=True)):
        m = POINTER_RE.match(line)
        (
            removed.append((i, line))
            if m and norm_target(m["target"]) in targets
            else kept.append(line)
        )
    if removed:
        atomic_write(index_path, "".join(kept))
    return removed


def delete(mem: Memory, also: list[Memory]) -> Deletion:
    files = []
    if mem.path and mem.path.exists():
        files.append((mem.path, mem.path.read_bytes()))
        mem.path.unlink()
    targets = {mem.filename} | {m.filename for m in also}
    lines = remove_pointers(mem.project.index_path, targets)
    return Deletion(mem.title, mem.project.index_path, files, lines)


def restore(d: Deletion) -> None:
    for path, data in d.files:
        if path.exists():
            raise FileExistsError(f"{path.name} exists again; not overwriting")
    for path, data in d.files:
        path.write_bytes(data)
    if d.lines:
        lines = (
            d.index_path.read_text().splitlines(keepends=True)
            if d.index_path.exists()
            else []
        )
        for i, text in sorted(d.lines):
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            lines.insert(
                min(i, len(lines)), text if text.endswith("\n") else text + "\n"
            )
        atomic_write(d.index_path, "".join(lines))


def add_pointer(mem: Memory) -> None:
    line = (
        f"- [{mem.title}]({mem.filename})"
        + (f" — {mem.description}" if mem.description else "")
        + "\n"
    )
    text = read_text(mem.project.index_path)
    if text and not text.endswith("\n"):
        text += "\n"
    atomic_write(mem.project.index_path, text + line)


def matches(haystack: str, query: str) -> bool:
    return all(term in haystack for term in query.lower().split())


def ago(ts: float) -> str:
    s = max(0, time.time() - ts)
    for limit, div, unit in (
        (60, 1, "s"),
        (3600, 60, "m"),
        (86400, 3600, "h"),
        (86400 * 14, 86400, "d"),
        (86400 * 60, 604800, "w"),
        (86400 * 365, 2592000, "mo"),
    ):
        if s < limit:
            return "now" if unit == "s" else f"{int(s // div)}{unit}"
    return f"{int(s // 31536000)}y"


