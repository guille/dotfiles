#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

source "$SCRIPT_BASE_DIR/common"

##
# OpenCode
##

module_name=opencode


mkdir -p ~/.config/opencode/plugins

infoprint "[$module_name] creating dotfiles symlinks..."

ln -sf "${SCRIPT_BASE_DIR}/$module_name/cli.json" ~/.config/opencode/cli.json
ln -sf "${SCRIPT_BASE_DIR}/$module_name/opencode.json" ~/.config/opencode/opencode.json

ln -sf "${SCRIPT_BASE_DIR}/$module_name/notify.ts" ~/.config/opencode/plugins/notify.ts
ln -sf "${SCRIPT_BASE_DIR}/$module_name/summarize.ts" ~/.config/opencode/plugins/summarize.ts
ln -sf "${SCRIPT_BASE_DIR}/$module_name/trash.ts" ~/.config/opencode/plugins/trash.ts
