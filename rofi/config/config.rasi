configuration {
	modes: "drun";
	font: "0xProto Nerd Font 10";
	case-smart: true;
	matching-negate-char: "";
	normalize-match: true;
	show-icons: true;
	sort: true;
	icon-theme: "Papirus";
	drun-match-fields: "name,exec";
	matching: "fuzzy";
	sorting-method: "fzf";
	/*
	TODO: rofi >= 2.0.0
	sorting-method: "fzf-v2";
	*/
	display-drun: "Apps";
	display-run:                "";
	display-filebrowser:        "";
	display-window:             "";
	window-format:              "{w} · {c} · {t}";

	drun {
		fallback-icon: "application-x-addon";
	}
}

@theme "launcher.rasi"
