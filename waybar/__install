#!/usr/bin/env bash
# shellcheck disable=SC1091

set -e

source "$SCRIPT_BASE_DIR/common"

##
# Waybar
##

module_name=waybar


# Linux only
if [[ "${DOTFILES_OS:-}" == "OSX" ]]; then
	exit
fi

mkdir -p ~/.config/waybar/scripts

infoprint "[$module_name] creating dotfiles symlinks..."

ln -sf "${SCRIPT_BASE_DIR}/$module_name/config.json" ~/.config/waybar/config
ln -sf "${SCRIPT_BASE_DIR}/$module_name/style.css" ~/.config/waybar/style.css
ln -sf "${SCRIPT_BASE_DIR}/$module_name/scripts/"* ~/.config/waybar/scripts/
