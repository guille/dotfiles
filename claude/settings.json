{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(*)",
      "Glob",
      "Grep",
      "Read(*)",
      "Bash(bundle exec rspec *)",
      "Bash(bundle exec rubocop *)",
      "Bash(dart analyze *)",
      "Bash(flutter analyze *)",
      "Bash(flutter gen-l10n *)",
      "Bash(flutter test *)",
      "Bash(go build *)",
      "Bash(go env *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(gotestsum *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mise run *)",
      "Bash(mix *)",
      "Bash(mkdir *)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(true)",
      "Bash(uv run pytest *)",
      "Bash(wc *)"
    ],
    "deny": [
      "NotebookEdit",
      "WebSearch",
      "Bash(npx *)",
      "Bash(rm *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/go/pkg/mod",
      "~/work"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "legacy-context": "name-only",
    "code-review": "user-invocable-only",
    "deploy": "off"
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "okto-blocks@nearbyone": false
  },
  "extraKnownMarketplaces": {
    "nearbyone": {
      "source": {
        "source": "git",
        "url": "https://github.com/nbycomp/claude-marketplace.git"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Fucking around",
      "Finding out"
    ]
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
