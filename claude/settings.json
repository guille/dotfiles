{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "NotebookEdit",
      "WebSearch",
      "Bash(npx *)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/go/pkg/mod",
      "~/work"
    ]
  },
  "model": "opus",
  "skillOverrides": {
    "legacy-context": "name-only",
    "code-review": "user-invocable-only",
    "deploy": "off"
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh",
    "padding": 1
  },
  "preferredNotifChannel": "notifications_disabled",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify-hook.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "okto-blocks@nearbyone": false
  },
  "extraKnownMarketplaces": {
    "nearbyone": {
      "source": {
        "source": "git",
        "url": "https://github.com/nbycomp/claude-marketplace.git"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Fucking around",
      "Finding out"
    ]
  },
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto"
}
